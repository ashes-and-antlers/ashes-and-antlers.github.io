{
  "name": "ashes-and-antlers",
  "private": true,
  "version": "0.1.0",
  "description": "Ashes and Antlers (working title) — server-authoritative tick-based galaxy strategy. Workspace: web/api/worker apps + contracts/content/domain/db packages. Milestone 1: deterministic tick engine + economy on PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @ashes/api --filter @ashes/web dev",
    "dev:worker": "pnpm --filter @ashes/worker dev",
    "build": "pnpm -r run build",
    "preview": "pnpm --filter @ashes/web preview",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "pnpm --filter @ashes/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @ashes/db exec tsx src/migrate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
